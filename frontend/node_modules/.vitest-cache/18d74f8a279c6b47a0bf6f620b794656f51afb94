IAAO,OAAO,MAAM;IAAM,WAAW;IAAK,WAAW,UAAU,SAAS,EAAE,MAAM,MAAM,OAAO,MAAM,CAAC;GAAI;;;;WACnG;;;;;GACP,iDAAC,SAAD,aAAO,eAEL,iDAAC,YAAD;IACE,OAAO,MAAM;IACb,MAAM;IACN,WAAW;IACX,WAAW,UAAU,SAAS,EAAE,aAAa,MAAM,OAAO,MAAM,CAAC;GAClE;;;;WACI;;;;;GAEN,MAAM,QAAQ,KAAK,QAAQ,UAC1B,iDAAC,YAAD;IAA0B,WAAU;cAApC;KACE,iDAAC,UAAD,aAAQ,WAAQ,QAAQ,CAAU;;;;;KACjC,CAAC,aACA,iDAAC,SAAD,aAAO,QAEL,iDAAC,UAAD;MAAQ,OAAO,OAAO;MAAM,WAAW,UAAU,WAAW,QAAQ,MAAM,OAAO,KAAmB;gBACjG,aAAa,KAAK,SACjB,iDAAC,UAAD;OAAyB,OAAO,KAAK;iBAClC,KAAK;MACA,GAFK,KAAK;;;;aAEV,CACT;KACK;;;;aACH;;;;;KAER,OAAO,SAAS,oBACf,iDAAC,SAAD,aAAO,UAEL,iDAAC,UAAD;MAAQ,OAAO,OAAO,UAAU;MAAI,WAAW,UAAU,UAAU,OAAO,IAAI,EAAE,QAAQ,MAAM,OAAO,SAAS,KAAK,CAAC;gBACjH,KAAK,QAAQ,KAAK,WACjB,iDAAC,UAAD;OAAwB,OAAO,OAAO;iBACnC,OAAO;MACF,GAFK,OAAO;;;;aAEZ,CACT;KACK;;;;aACH;;;;;KAER,OAAO,SAAS,wBACf,iDAAC,SAAD,aAAO,WAEL,iDAAC,UAAD;MAAQ,OAAO,OAAO,WAAW;MAAI,WAAW,UAAU,UAAU,OAAO,IAAI,EAAE,SAAS,MAAM,OAAO,SAAS,KAAK,CAAC;gBAAtH,CACG,OAAO,SAAS,oBAAoB,iDAAC,UAAD;OAAQ,OAAM;iBAAG;MAAoB;;;;gBACzE,KAAK,SAAS,KAAK,YAClB,iDAAC,UAAD;OAAyB,OAAO,QAAQ;iBACrC,QAAQ;MACH,GAFK,QAAQ;;;;aAEb,CACT,CACK;;;;;aACH;;;;;KAET,iDAAC,SAAD,aACG,YAAY,YAAY,UACzB,iDAAC,UAAD;MAAQ,OAAO,OAAO;MAAO,WAAW,UAAU,UAAU,OAAO,IAAI,EAAE,OAAO,OAAO,MAAM,OAAO,KAAK,EAAE,CAAC;iBACxG,YAAY,YAAY,OAAM,CAAE,KAAK,UACrC,iDAAC,UAAD;OAAoB,OAAO;iBACxB,iCAAO,KAAK;MACP,GAFK;;;;aAEL,CACT;KACK;;;;aACH;;;;;KACN,CAAC,aAAa,MAAM,QAAQ,SAAS,KACpC,iDAAC,UAAD;MACE,MAAK;MACL,WAAU;MACV,eAAe,SAAS,EAAE,SAAS,MAAM,QAAQ,QAAQ,SAAS,KAAK,OAAO,OAAO,EAAE,EAAE,CAAC;gBAC3F;KAEO;;;;;IAEF;MA1DK,OAAO;;;;UA0DZ,CACX;GAEA,CAAC,aAAa,MAAM,QAAQ,SAAS,MACpC,iDAAC,UAAD;IACE,MAAK;IACL,WAAU;IACV,eACE,SAAS,EACP,SAAS,CACP,GAAG,MAAM,SACT;KAAE,IAAI,sCAAW;KAAG,MAAM;KAAsB,QAAQ,KAAK,QAAQ,EAAE,EAAE,QAAQ;KAAM,SAAS;KAAM,OAAO;IAAE,CACjH,EACF,CAAC;cAEJ;GAEO;;;;;EAEP;;;;;;AAET","names":[],"ignoreList":[],"sources":["EventsStep.tsx"],"sourcesContent":["import { useState } from 'react';\nimport type { Catalogue, EffectKind, EventInput, GameState } from '../../api/types';\nimport { Notice } from '../../components/GameLayout';\nimport { signed } from '../../lib/format';\nimport {\n  blankEvent,\n  describeDraftEffect,\n  initialDrafts,\n  instantiateTemplate,\n  newDraftId,\n  toEventInputs,\n  validateDrafts,\n  type DraftEffect,\n  type DraftEvent,\n} from './events';\nimport { StepActions } from './SetupFrame';\n\nconst EFFECT_KINDS: { value: EffectKind; label: string }[] = [\n  { value: 'hazard_probability', label: 'Hazard probability' },\n  { value: 'vulnerability', label: 'Vulnerability' },\n  { value: 'element_status', label: 'Element status' },\n];\nconst DELTAS = [-5, -4, -3, -2, -1, 1, 2, 3, 4, 5];\nconst PENALTIES = [-1, -2, -3, -4, -5, -6];\n\ninterface EventsStepProps {\n  game: GameState;\n  catalogue: Catalogue;\n  busy: boolean;\n  onBack: () => void;\n  onFinish: (events: EventInput[]) => void;\n}\n\nexport function EventsStep({ game, catalogue, busy, onBack, onFinish }: EventsStepProps) {\n  const [drafts, setDrafts] = useState<DraftEvent[]>(() => initialDrafts(game, catalogue));\n  const [editingId, setEditingId] = useState<string | null>(null);\n  const { limits } = catalogue;\n\n  const update = (id: string, patch: Partial<DraftEvent>) =>\n    setDrafts((current) => current.map((draft) => (draft.id === id ? { ...draft, ...patch } : draft)));\n  const remove = (id: string) => setDrafts((current) => current.filter((draft) => draft.id !== id));\n  const add = (draft: DraftEvent, edit = false) => {\n    setDrafts((current) => [...current, draft]);\n    if (edit) setEditingId(draft.id);\n  };\n\n  const problems = validateDrafts(drafts, limits);\n  const rounds = Array.from({ length: game.total_rounds }, (_, index) => index + 1);\n\n  return (\n    <>\n      <div className=\"round-cards\">\n        {rounds.map((round) => {\n          const inRound = drafts.filter((draft) => draft.round === round);\n          const enabledCount = inRound.filter((draft) => draft.enabled).length;\n          return (\n            <section key={round} className=\"round-card\" aria-label={`Round ${round} events`}>\n              <h2 className=\"round-card__band\">ROUND {round}</h2>\n              <div className=\"round-card__body\">\n                {inRound.length === 0 && <p className=\"muted\">No event in this round.</p>}\n                {inRound.map((draft) => (\n                  <EventDraftCard\n                    key={draft.id}\n                    game={game}\n                    draft={draft}\n                    editing={editingId === draft.id}\n                    onEdit={() => setEditingId(editingId === draft.id ? null : draft.id)}\n                    onChange={(patch) => update(draft.id, patch)}\n                    onRemove={() => remove(draft.id)}\n                  />\n                ))}\n                <AddEvent\n                  game={game}\n                  catalogue={catalogue}\n                  round={round}\n                  full={enabledCount >= limits.events_per_round_max}\n                  onAdd={add}\n                />\n              </div>\n            </section>\n          );\n        })}\n      </div>\n\n      <p className=\"muted\">\n        Special action: Reduce emissions is the game&rsquo;s only special action. It is available once in each of Rounds{' '}\n        {limits.reduce_emissions_rounds.join(' and ')} and is linked to the mandatory Round{' '}\n        {limits.transition_pressure_round} Transition pressure event. Future events stay hidden from players.\n      </p>\n\n      {problems.length > 0 && (\n        <Notice tone=\"warning\">\n          <ul className=\"plain-list\">\n            {problems.map((problem) => (\n              <li key={problem}>{problem}</li>\n            ))}\n          </ul>\n        </Notice>\n      )}\n\n      <StepActions\n        onBack={onBack}\n        onNext={() => onFinish(toEventInputs(game, drafts))}\n        nextLabel=\"Finish setup\"\n        nextDisabled={problems.length > 0}\n        busy={busy}\n      />\n    </>\n  );\n}\n\nfunction AddEvent({\n  game,\n  catalogue,\n  round,\n  full,\n  onAdd,\n}: {\n  game: GameState;\n  catalogue: Catalogue;\n  round: number;\n  full: boolean;\n  onAdd: (draft: DraftEvent, edit?: boolean) => void;\n}) {\n  const templates = catalogue.event_templates\n    .filter((template) => template.type === 'standard')\n    .filter((template) => instantiateTemplate(template, game, round) !== null);\n\n  return (\n    <label className=\"add-event\">\n      <span className=\"sr-only\">Add an event to Round {round}</span>\n      <select\n        value=\"\"\n        disabled={full}\n        onChange={(event) => {\n          const value = event.target.value;\n          if (value === '__custom') return onAdd(blankEvent(game, round), true);\n          const template = templates.find((item) => item.key === value);\n          const draft = template && instantiateTemplate(template, game, round);\n          if (draft) onAdd(draft);\n        }}\n      >\n        <option value=\"\">{full ? 'Maximum events reached' : '+ Add event'}</option>\n        {templates.map((template) => (\n          <option key={template.key} value={template.key}>\n            {template.name}\n          </option>\n        ))}\n        <option value=\"__custom\">Custom event&hellip;</option>\n      </select>\n    </label>\n  );\n}\n\nfunction EventDraftCard({\n  game,\n  draft,\n  editing,\n  onEdit,\n  onChange,\n  onRemove,\n}: {\n  game: GameState;\n  draft: DraftEvent;\n  editing: boolean;\n  onEdit: () => void;\n  onChange: (patch: Partial<DraftEvent>) => void;\n  onRemove: () => void;\n}) {\n  const mandatory = draft.type === 'transition_pressure';\n  return (\n    <article className={`draft-card${draft.enabled ? '' : ' is-disabled'}`}>\n      <h3 className=\"draft-card__title\">\n        {draft.name || 'Untitled event'}\n        {mandatory && <span className=\"badge badge--pink\">Mandatory</span>}\n      </h3>\n      <ul className=\"draft-card__effects\">\n        {draft.effects.map((effect) => (\n          <li key={effect.id}>{describeDraftEffect(effect, draft.type)}</li>\n        ))}\n      </ul>\n      <div className=\"draft-card__actions\">\n        <label className=\"toggle\">\n          <input\n            type=\"checkbox\"\n            checked={draft.enabled}\n            disabled={mandatory}\n            onChange={(event) => onChange({ enabled: event.target.checked })}\n          />\n          Enabled\n        </label>\n        <button type=\"button\" className=\"btn btn--tiny\" onClick={onEdit} aria-expanded={editing}>\n          {editing ? 'Done' : 'Edit'}\n        </button>\n        {!mandatory && (\n          <button type=\"button\" className=\"btn btn--tiny\" onClick={onRemove}>\n            Remove\n          </button>\n        )}\n      </div>\n      {editing && <EventEditor game={game} draft={draft} onChange={onChange} />}\n      <p className=\"draft-card__note\">\n        {mandatory\n          ? 'Moderator can edit the penalty; this event is mandatory.'\n          : 'Moderator can edit this card or disable this event.'}\n      </p>\n    </article>\n  );\n}\n\nfunction EventEditor({\n  game,\n  draft,\n  onChange,\n}: {\n  game: GameState;\n  draft: DraftEvent;\n  onChange: (patch: Partial<DraftEvent>) => void;\n}) {\n  const mandatory = draft.type === 'transition_pressure';\n  const setEffect = (id: string, patch: Partial<DraftEffect>) =>\n    onChange({ effects: draft.effects.map((effect) => (effect.id === id ? { ...effect, ...patch } : effect)) });\n\n  const changeKind = (effect: DraftEffect, kind: EffectKind) =>\n    setEffect(effect.id, {\n      kind,\n      hazard: kind === 'element_status' ? null : (effect.hazard ?? game.hazards[0]?.name ?? null),\n      element:\n        kind === 'hazard_probability' ? null : kind === 'vulnerability' ? (effect.element ?? game.elements[0]?.name ?? null) : effect.element,\n    });\n\n  return (\n    <div className=\"event-editor\">\n      <label>\n        Event name\n        <input value={draft.name} maxLength={120} onChange={(event) => onChange({ name: event.target.value })} />\n      </label>\n      <label>\n        Description\n        <textarea\n          value={draft.description}\n          rows={2}\n          maxLength={1000}\n          onChange={(event) => onChange({ description: event.target.value })}\n        />\n      </label>\n\n      {draft.effects.map((effect, index) => (\n        <fieldset key={effect.id} className=\"effect-row\">\n          <legend>Effect {index + 1}</legend>\n          {!mandatory && (\n            <label>\n              Kind\n              <select value={effect.kind} onChange={(event) => changeKind(effect, event.target.value as EffectKind)}>\n                {EFFECT_KINDS.map((kind) => (\n                  <option key={kind.value} value={kind.value}>\n                    {kind.label}\n                  </option>\n                ))}\n              </select>\n            </label>\n          )}\n          {effect.kind !== 'element_status' && (\n            <label>\n              Hazard\n              <select value={effect.hazard ?? ''} onChange={(event) => setEffect(effect.id, { hazard: event.target.value || null })}>\n                {game.hazards.map((hazard) => (\n                  <option key={hazard.id} value={hazard.name}>\n                    {hazard.name}\n                  </option>\n                ))}\n              </select>\n            </label>\n          )}\n          {effect.kind !== 'hazard_probability' && (\n            <label>\n              Element\n              <select value={effect.element ?? ''} onChange={(event) => setEffect(effect.id, { element: event.target.value || null })}>\n                {effect.kind === 'element_status' && <option value=\"\">All elements</option>}\n                {game.elements.map((element) => (\n                  <option key={element.id} value={element.name}>\n                    {element.name}\n                  </option>\n                ))}\n              </select>\n            </label>\n          )}\n          <label>\n            {mandatory ? 'Penalty' : 'Change'}\n            <select value={effect.delta} onChange={(event) => setEffect(effect.id, { delta: Number(event.target.value) })}>\n              {(mandatory ? PENALTIES : DELTAS).map((delta) => (\n                <option key={delta} value={delta}>\n                  {signed(delta)}\n                </option>\n              ))}\n            </select>\n          </label>\n          {!mandatory && draft.effects.length > 1 && (\n            <button\n              type=\"button\"\n              className=\"btn btn--tiny\"\n              onClick={() => onChange({ effects: draft.effects.filter((item) => item.id !== effect.id) })}\n            >\n              Remove effect\n            </button>\n          )}\n        </fieldset>\n      ))}\n\n      {!mandatory && draft.effects.length < 20 && (\n        <button\n          type=\"button\"\n          className=\"btn btn--soft btn--small\"\n          onClick={() =>\n            onChange({\n              effects: [\n                ...draft.effects,\n                { id: newDraftId(), kind: 'hazard_probability', hazard: game.hazards[0]?.name ?? null, element: null, delta: 1 },\n              ],\n            })\n          }\n        >\n          + Add effect\n        </button>\n      )}\n    </div>\n  );\n}\n"],"file":"/src/features/setup/EventsStep.tsx"}