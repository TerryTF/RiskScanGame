: string;\n  children: ReactNode;\n}\n\nexport function GameLayout({ crumb, pill, title, subtitle, info, children }: GameLayoutProps) {\n  const bar = useContext(ModeratorBarContext);\n  const reviewing = Boolean(bar?.onReturn);\n  return (\n    <div className=\"app\">\n      <div className=\"topbar\" aria-hidden=\"true\" />\n      <header className=\"header\">\n        <Link to=\"/\" className=\"brand\">\n          RISKSCAN\n        </Link>\n        <span className=\"crumb\">{crumb}</span>\n        <span className=\"pill\" aria-live=\"polite\">\n          {pill}\n        </span>\n        {bar && <ModeratorBar {...bar} />}\n      </header>\n      <main className=\"page\" inert={reviewing || undefined}>\n        {reviewing && (\n          <Notice tone=\"warning\">\n            This earlier screen is shown as it was and cannot be changed. Return to the current screen to carry on.\n          </Notice>\n        )}\n        {title && <h1 className=\"page-title\">{title}</h1>}\n        {subtitle && <p className=\"page-subtitle\">{subtitle}</p>}\n        {children}\n      </main>\n      {info && (\n        <footer className=\"infobar\" role=\"status\">\n          {info}\n        </footer>\n      )}\n    </div>\n  );\n}\n\n/** The board on the left and a column of panels on the right, as in the storyboard. */\nexport function BoardLayout({ board, side }: { board: ReactNode; side: ReactNode }) {\n  return (\n    <div className=\"board-layout\">\n      <div className=\"board-column\">{board}</div>\n      <aside className=\"side-column\">{side}</aside>\n    </div>\n  );\n}\n\nexport function Panel({\n  kicker,\n  title,\n  children,\n  className = '',\n}: {\n  kicker?: string;\n  title?: string;\n  children: ReactNode;\n  className?: string;\n}) {\n  return (\n    <section className={`panel ${className}`.trim()}>\n      {kicker && <p className=\"panel-kicker\">{kicker}</p>}\n      {title && <h2 className=\"panel-title\">{title}</h2>}\n      {children}\n    </section>\n  );\n}\n\nexport function Notice({ tone = 'info', children }: { tone?: 'info' | 'error' | 'warning'; children: ReactNode }) {\n  return (\n    <div className={`notice notice--${tone}`} role={tone === 'error' ? 'alert' : 'note'}>\n      {children}\n    </div>\n  );\n}\n\nexport function FullPageMessage({ title, children }: { title: string; children?: ReactNode }) {\n  return (\n    <div className=\"app\">\n      <div className=\"topbar\" aria-hidden=\"true\" />\n      <main className=\"page page--centered\">\n        <h1 className=\"page-title\">{title}</h1>\n        {children}\n      </main>\n    </div>\n  );\n}\n"],"file":"/src/components/GameLayout.tsx"}