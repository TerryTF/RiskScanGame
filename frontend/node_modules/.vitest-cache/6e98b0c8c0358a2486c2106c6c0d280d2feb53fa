const STORAGE_KEY = "riskscan.recentGames";
const MAX_RECENT = 8;
/** Games this browser created or opened, so a moderator can find them again. Never throws. */
function readRecentGames() {
	try {
		const parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) ?? "[]");
		if (!Array.isArray(parsed)) return [];
		return parsed.filter((item) => typeof item?.id === "string" && typeof item?.name === "string" && typeof item?.savedAt === "number");
	} catch {
		return [];
	}
};
function rememberGame(game) {
	const others = readRecentGames().filter((recent) => recent.id !== game.id);
	const next = [{
		id: game.id,
		name: game.destination_name,
		savedAt: Date.now()
	}, ...others].slice(0, MAX_RECENT);
	try {
		localStorage.setItem(STORAGE_KEY, JSON.stringify(next));
	} catch {}
};
function forgetGame(id) {
	try {
		localStorage.setItem(STORAGE_KEY, JSON.stringify(readRecentGames().filter((recent) => recent.id !== id)));
	} catch {}
}

