,CACH,CACQ;QAxBK;;;;YAwBL;IAEd,CAAC;GACE;;;;;GACJ,QAAQ,SAAS,KAAK,mBACrB,kDAAC,KAAD;IAAG,WAAU;IAAQ,MAAK;cAA1B;KAAmC;KACgC,QAAQ,KAAK,IAAI;KAAE;IACnF;;;;;;GAEL,kDAAC,OAAD;IAAK,WAAU;cAAf;KACE,kDAAC,UAAD;MAAQ,MAAK;MAAS,WAAU;MAAiB,SAAS;MAAQ,UAAU;gBAAM;KAE1E;;;;;KACR,kDAAC,UAAD;MAAQ,MAAK;MAAS,WAAU;MAAgB,SAAS;MAAM,UAAU,QAAQ,CAAC,mBAAmB,CAAC;gBAAO;KAErG;;;;;KACR,kDAAC,UAAD;MAAQ,MAAK;MAAS,WAAU;MAAmB,SAAS;MAAS,UAAU,QAAQ,SAAS,CAAC;gBAAe;KAExG;;;;;MACN,SAAS,CAAC,kBAAkB,kDAAC,QAAD;MAAM,WAAU;gBAAqB;KAA2C;;;;;IAC3G;;;;;;EACE;;;;;;AAEb","names":[],"ignoreList":[],"sources":["TeamsStage.tsx"],"sourcesContent":["import { useState } from 'react';\nimport { RESOURCE_TYPES, TEAM_ROLES } from '../../api/types';\nimport type { Catalogue, GameState, Limits, Resources, TeamPrioritiesInput, TeamRole } from '../../api/types';\nimport type { GameCommands } from '../../api/queries';\nimport { TEAM_ICON } from '../../assets/icons';\nimport { BoardScreen } from '../../components/BoardScreen';\nimport { Panel } from '../../components/GameLayout';\nimport { TeamBadge } from '../../components/Tokens';\nimport { stepCopy, type StepCopy } from '../../lib/copy';\nimport { elementName, orderedTeams, teamByRole, type Changes } from '../../lib/derive';\nimport { ROLE_LABEL } from '../../lib/format';\nimport { ShareBoard } from '../setup/ShareBoard';\n\ntype Stage = 'teams' | 'priorities';\n\nconst PRIORITIES_COPY: StepCopy = {\n  pill: 'TEAM PRIORITIES',\n  title: 'Choose team priorities: teams place markers on four elements each',\n  subtitle:\n    'Large and small markers use the stakeholder symbols. Elements nobody chooses are removed from the active destination.',\n  info: 'MARKERS \\u2022 Large symbols count double in scoring. The same team may not mark an element twice.',\n};\n\nexport function allowanceText(allowance: Resources): string {\n  const parts = RESOURCE_TYPES.map((resource) => ({ resource, amount: allowance[resource] }))\n    .filter((part) => part.amount > 0)\n    .sort((a, b) => b.amount - a.amount);\n  return `${parts.map((part) => `${part.amount} ${part.resource}`).join(' + ')} per round`;\n}\n\ninterface TeamsStageProps {\n  game: GameState;\n  catalogue: Catalogue;\n  commands: GameCommands;\n  changes: Changes;\n}\n\n/** Between setup and Round 0: introduce the role cards, then place each team's four priority markers. */\nexport function TeamsStage({ game, catalogue, commands, changes }: TeamsStageProps) {\n  const complete = game.teams.every((team) => team.priorities.length === 4);\n  const [stage, setStage] = useState<Stage>(complete ? 'priorities' : 'teams');\n\n  if (stage === 'teams') {\n    return (\n      <BoardScreen\n        game={game}\n        copy={stepCopy(game)}\n        showPriorities={false}\n        error={commands.error}\n        side={\n          <>\n            <Panel kicker=\"Share the board\">\n              <ShareBoard gameId={game.id} />\n            </Panel>\n            <RoleCards\n              game={game}\n              catalogue={catalogue}\n              busy={commands.pending}\n              onContinue={async (members) => {\n                const changed = TEAM_ROLES.some((role) => (teamByRole(game, role)?.members ?? []).join(',') !== members[role].join(','));\n                if (!changed || (await commands.setTeams(TEAM_ROLES.map((role) => ({ role, members: members[role] }))))) {\n                  setStage('priorities');\n                }\n              }}\n            />\n            <EventQueue game={game} />\n          </>\n        }\n      />\n    );\n  }\n\n  return (\n    <BoardScreen\n      game={game}\n      copy={PRIORITIES_COPY}\n      changes={changes}\n      error={commands.error}\n      side={\n        <>\n          <TeamSummaryPanel game={game} limits={catalogue.limits} />\n          <EventQueue game={game} />\n        </>\n      }\n      below={\n        <PrioritiesEditor\n          game={game}\n          limits={catalogue.limits}\n          busy={commands.pending}\n          onBack={() => setStage('teams')}\n          onSave={(teams) => commands.setPriorities(teams)}\n          onStart={() => commands.startRoundZero()}\n        />\n      }\n    />\n  );\n}\n\n/** Each team's role and, once chosen, its four priority elements. Shown to moderator and participants alike. */\nexport function TeamSummaryPanel({ game, limits }: { game: GameState; limits: Limits }) {\n  return (\n    <Panel kicker=\"Three teams &bull; priorities\">\n      <ul className=\"team-summary\">\n        {orderedTeams(game).map((team) => {\n          const Icon = TEAM_ICON[team.role];\n          const chosen = team.priorities.length === limits.large_priorities_per_team + limits.small_priorities_per_team;\n          return (\n            <li key={team.id} className={`team-summary__row team--${team.role}`}>\n              <Icon size={40} />\n              <div>\n                <strong>{ROLE_LABEL[team.role]}</strong>\n                <span className=\"muted\">\n                  {chosen\n                    ? team.priorities\n                        .map((p) => `${elementName(game, p.element_id)} (\\u00d7${p.size === 'large' ? 2 : 1})`)\n                        .join(', ')\n                    : `${limits.large_priorities_per_team} large \\u00d72 + ${limits.small_priorities_per_team} small \\u00d71`}\n                </span>\n              </div>\n            </li>\n          );\n        })}\n      </ul>\n    </Panel>\n  );\n}\n\nfunction RoleCards({\n  game,\n  catalogue,\n  busy,\n  onContinue,\n}: {\n  game: GameState;\n  catalogue: Catalogue;\n  busy: boolean;\n  onContinue: (members: Record<TeamRole, string[]>) => void;\n}) {\n  const [members, setMembers] = useState<Record<TeamRole, string>>(() => ({\n    local_government: (teamByRole(game, 'local_government')?.members ?? []).join(', '),\n    tourism_industry: (teamByRole(game, 'tourism_industry')?.members ?? []).join(', '),\n    civil_society: (teamByRole(game, 'civil_society')?.members ?? []).join(', '),\n  }));\n  const parse = (text: string) =>\n    text\n      .split(',')\n      .map((name) => name.trim())\n      .filter(Boolean);\n\n  return (\n    <Panel kicker=\"Three role cards\" className=\"role-cards\">\n      {catalogue.teams.map((card) => {\n        const Icon = TEAM_ICON[card.role];\n        return (\n          <article key={card.role} className={`role-card team--${card.role}`}>\n            <Icon size={56} />\n            <div>\n              <h3>{ROLE_LABEL[card.role]}</h3>\n              <p className=\"role-card__allowance\">{allowanceText(card.allowance)}</p>\n              <p className=\"muted\">Interests: {card.interests.join(', ')}</p>\n              <label>\n                <span className=\"sr-only\">{ROLE_LABEL[card.role]} members</span>\n                <input\n                  value={members[card.role]}\n                  placeholder=\"Team members (optional, comma separated)\"\n                  onChange={(event) => setMembers({ ...members, [card.role]: event.target.value })}\n                />\n              </label>\n            </div>\n          </article>\n        );\n      })}\n      <p className=\"muted\">Resource allocations start in Round 1, not now.</p>\n      <button\n        type=\"button\"\n        className=\"btn btn--primary\"\n        disabled={busy}\n        onClick={() =>\n          onContinue({\n            local_government: parse(members.local_government),\n            tourism_industry: parse(members.tourism_industry),\n            civil_society: parse(members.civil_society),\n          })\n        }\n      >\n        Continue to team priorities\n      </button>\n    </Panel>\n  );\n}\n\n/** The moderator's view of every configured event. Players never see this list. */\nexport function EventQueue({ game }: { game: GameState }) {\n  const events = [...game.events].sort((a, b) => a.round - b.round);\n  return (\n    <Panel kicker=\"Moderator only\" title=\"Event queue\" className=\"event-queue\">\n      {events.length === 0 ? (\n        <p className=\"muted\">No events configured.</p>\n      ) : (\n        <ul className=\"queue\">\n          {events.map((event) => (\n            <li key={event.id} className={`queue__item queue__item--${event.status}`}>\n              <span className=\"queue__round\">R{event.round}</span>\n              <span>{event.name}</span>\n              <span className=\"queue__status\">{event.status}</span>\n            </li>\n          ))}\n        </ul>\n      )}\n      <p className=\"muted\">Future events stay hidden from participants.</p>\n    </Panel>\n  );\n}\n\ntype Slots = { large: (number | null)[]; small: (number | null)[] };\n\nconst slotsOf = (game: GameState, role: TeamRole, limits: Limits): Slots => {\n  const priorities = teamByRole(game, role)?.priorities ?? [];\n  const pick = (size: 'large' | 'small', count: number) =>\n    Array.from({ length: count }, (_, index) => priorities.filter((p) => p.size === size)[index]?.element_id ?? null);\n  return { large: pick('large', limits.large_priorities_per_team), small: pick('small', limits.small_priorities_per_team) };\n};\n\nfunction PrioritiesEditor({\n  game,\n  limits,\n  busy,\n  onBack,\n  onSave,\n  onStart,\n}: {\n  game: GameState;\n  limits: Limits;\n  busy: boolean;\n  onBack: () => void;\n  onSave: (teams: TeamPrioritiesInput[]) => void;\n  onStart: () => void;\n}) {\n  const saved = Object.fromEntries(TEAM_ROLES.map((role) => [role, slotsOf(game, role, limits)])) as Record<TeamRole, Slots>;\n  const [draft, setDraft] = useState<Record<TeamRole, Slots>>(saved);\n\n  const everySlotFilled = TEAM_ROLES.every((role) => [...draft[role].large, ...draft[role].small].every((id) => id !== null));\n  const dirty = JSON.stringify(draft) !== JSON.stringify(saved);\n  const savedComplete = game.teams.every((team) => team.priorities.length === limits.large_priorities_per_team + limits.small_priorities_per_team);\n\n  const chosen = new Set(TEAM_ROLES.flatMap((role) => [...draft[role].large, ...draft[role].small]).filter((id): id is number => id !== null));\n  const dropped = game.elements.filter((element) => !chosen.has(element.id)).map((element) => element.name);\n\n  const setSlot = (role: TeamRole, size: 'large' | 'small', index: number, value: number | null) =>\n    setDraft((current) => {\n      const slots = { ...current[role], [size]: current[role][size].map((id, i) => (i === index ? value : id)) };\n      return { ...current, [role]: slots };\n    });\n\n  const save = () =>\n    onSave(\n      TEAM_ROLES.map((role) => ({\n        role,\n        large: draft[role].large.filter((id): id is number => id !== null),\n        small: draft[role].small.filter((id): id is number => id !== null),\n      })),\n    );\n\n  return (\n    <section className=\"priorities\" aria-label=\"Team priorities\">\n      <div className=\"priorities__teams\">\n        {TEAM_ROLES.map((role) => {\n          const used = new Set([...draft[role].large, ...draft[role].small]);\n          return (\n            <fieldset key={role} className={`priority-team team--${role}`}>\n              <legend>\n                <TeamBadge role={role} size={26} />\n              </legend>\n              {(['large', 'small'] as const).flatMap((size) =>\n                draft[role][size].map((value, index) => (\n                  <label key={`${size}-${index}`}>\n                    {size === 'large' ? 'Large' : 'Small'} marker {index + 1} (&times;{size === 'large' ? 2 : 1})\n                    <select\n                      value={value ?? ''}\n                      onChange={(event) => setSlot(role, size, index, event.target.value === '' ? null : Number(event.target.value))}\n                    >\n                      <option value=\"\">Choose an element</option>\n                      {game.elements\n                        .filter((element) => element.id === value || !used.has(element.id))\n                        .map((element) => (\n                          <option key={element.id} value={element.id}>\n                            {element.name}\n                          </option>\n                        ))}\n                    </select>\n                  </label>\n                )),\n              )}\n            </fieldset>\n          );\n        })}\n      </div>\n      {dropped.length > 0 && everySlotFilled && (\n        <p className=\"muted\" role=\"status\">\n          Not chosen by any team, so removed from the active destination: {dropped.join(', ')}.\n        </p>\n      )}\n      <div className=\"step-actions\">\n        <button type=\"button\" className=\"btn btn--ghost\" onClick={onBack} disabled={busy}>\n          Back to role cards\n        </button>\n        <button type=\"button\" className=\"btn btn--soft\" onClick={save} disabled={busy || !everySlotFilled || !dirty}>\n          Save priorities\n        </button>\n        <button type=\"button\" className=\"btn btn--primary\" onClick={onStart} disabled={busy || dirty || !savedComplete}>\n          Start Round 0\n        </button>\n        {(dirty || !savedComplete) && <span className=\"step-actions__hint\">Save the priorities to start Round 0.</span>}\n      </div>\n    </section>\n  );\n}\n"],"file":"/src/features/round/TeamsStage.tsx"}