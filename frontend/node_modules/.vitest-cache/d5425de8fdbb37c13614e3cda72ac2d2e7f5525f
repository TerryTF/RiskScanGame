;\n}\n\nconst OUTCOME_LABEL: Record<RollOutcome, string> = { trigger: 'TRIGGER', no_event: 'NO EVENT', skip: 'SKIP' };\n\n/** Every hazard's die with its outcome, in board order. */\nexport function HazardDiceList({ game, rolls }: { game: GameState; rolls: HazardRoll[] }) {\n  return (\n    <ul className=\"dice-list\">\n      {rolls.map((roll) => {\n        const outcome = rollOutcome(roll);\n        return (\n          <li key={roll.id} className=\"dice-list__row\">\n            <DiceFace value={roll.die} size={30} />\n            <span className=\"dice-list__name\">{hazardName(game, roll.hazard_id)}</span>\n            <span className={`outcome outcome--${outcome}`}>{OUTCOME_LABEL[outcome]}</span>\n          </li>\n        );\n      })}\n    </ul>\n  );\n}\n\nexport function StatusChangeList({\n  game,\n  changes,\n}: {\n  game: GameState;\n  changes: { elementId: number; before: number; after: number }[];\n}) {\n  if (changes.length === 0) return <p className=\"muted\">No element changed status.</p>;\n  return (\n    <ul className=\"change-list\">\n      {changes.map((change) => (\n        <li key={change.elementId}>\n          {elementName(game, change.elementId)}: {change.before} &rarr; {change.after}\n        </li>\n      ))}\n    </ul>\n  );\n}\n\nexport function ScoreList({ rows, winners = [] }: { rows: ScoreRow[]; winners?: number[] }) {\n  return (\n    <>\n      <ul className=\"score-list\">\n        {rows.map((row) => {\n          const Icon = TEAM_ICON[row.team.role];\n          return (\n            <li key={row.team.id} className={`score-row team--${row.team.role}`}>\n              <Icon size={42} />\n              <span className=\"score-row__name\">{ROLE_LABEL[row.team.role]}</span>\n              {winners.includes(row.team.id) && <span className=\"badge\">Winner</span>}\n              <strong className=\"score-row__value\" title={`Large ${row.large} + small ${row.small}`}>\n                {row.score}\n              </strong>\n            </li>\n          );\n        })}\n      </ul>\n      <p className=\"muted\">\n        Large priority = 2 &times; status\n        <br />\n        Small priority = 1 &times; status\n      </p>\n    </>\n  );\n}\n\nexport function HistoryList({ rounds }: { rounds: HistoryRound[] }) {\n  return (\n    <ol className=\"history\">\n      {rounds.map((entry) => (\n        <li key={entry.round} className=\"history__round\">\n          <h3>Round {entry.round}</h3>\n          {entry.lines.length > 0 ? (\n            <ul>\n              {entry.lines.map((line) => (\n                <li key={line}>{line}</li>\n              ))}\n            </ul>\n          ) : (\n            <p className=\"muted\">Nothing recorded yet.</p>\n          )}\n        </li>\n      ))}\n    </ol>\n  );\n}\n"],"file":"/src/components/Cards.tsx"}