OAAM;OAAsC;OAAM;MAC9E;;;;;MACH,iDAAC,UAAD;OACE,MAAK;OACL,WAAU;OACV,UAAU,SAAS;OACnB,eAAe,SAAS,WAAW;iBACpC;MAEO;;;;;MACR,iDAAC,UAAD;OAAQ,MAAK;OAAS,WAAU;OAAiB,eAAe,cAAc,KAAK;iBAAG;MAE9E;;;;;KACL;;;;;eAEL,iDAAC,UAAD;KACE,MAAK;KACL,WAAW,iBAAiB,OAAO,iBAAiB;KACpD,UAAU,SAAS;KACnB,eAAe,cAAc,IAAI;eAClC;IAEO;;;;;IAEV,iDAAC,KAAD;KAAG,WAAU;eAAQ;IAAsF;;;;;IAC3G,iDAAC,KAAD;KAAG,WAAU;eAAQ;IAAsD;;;;;GACtE;;;;;UACP;;;;;CAEL;;;;;AAEL;;AAGO,SAAS,YAAY,EAAE,MAAM,WAAkD;CACpF,MAAM,OAAO,4CAAkB,IAAI;CACnC,MAAM,OAAO,SAAS,OAAO,CAAC,IAAI,sCAAY,MAAM,IAAI;CACxD,OACE,oDAAC,oCAAD;EACQ;EACN,MAAM,mCAAS,IAAI;EACV;EACT,MAAM,iDAAC,WAAD;GAAiB;GAAY;EAAO;;;;;CAC3C;;;;;AAEL;AAEO,SAAS,UAAU,EAAE,MAAM,QAAmE;CACnG,OACE,kGACE,oDAAC,8BAAD;EAAO,QAAO;YACZ,oDAAC,kCAAD;GAAiB;GAAM,SAAS,KAAK;EAAU;;;;;CAC1C;;;;WACP,oDAAC,8BAAD;EAAO,QAAO;YACZ,oDAAC,oCAAD,EAAa,QAAQ,uCAAa,IAAI,EAAI;;;;;CACrC;;;;SACP;;;;;AAEN;AAEO,SAAS,YAAY,EAAE,QAA6B;CACzD,OACE,oDAAC,8BAAD;EAAO,QAAO;YACZ,oDAAC,uCAAD;GACE,SAAQ;GACR,MAAM,uCAAa,IAAI,CAAC,CAAC,KAAK,UAAU;IAAE,MAAM,KAAK;IAAM,WAAW,KAAK;GAAU,EAAE;EACxF;;;;;CACI;;;;;AAEX","names":[],"ignoreList":[],"sources":["StepScreens.tsx"],"sourcesContent":["import { useState } from 'react';\nimport type { Catalogue, GameState } from '../../api/types';\nimport type { GameCommands } from '../../api/queries';\nimport { DiceFace } from '../../assets/icons';\nimport { BoardScreen } from '../../components/BoardScreen';\nimport { EventCardView, HazardDiceList, HistoryList, ScoreList, StatusChangeList } from '../../components/Cards';\nimport { Panel } from '../../components/GameLayout';\nimport { ResourceTokens } from '../../components/Tokens';\nimport { stepCopy } from '../../lib/copy';\nimport {\n  buildHistory,\n  hazardDice,\n  hazardName,\n  hazardStatusChanges,\n  latestScoredRound,\n  orderedTeams,\n  roundScores,\n  type Changes,\n} from '../../lib/derive';\nimport { allowanceText, EventQueue } from './TeamsStage';\n\ninterface ScreenProps {\n  game: GameState;\n  catalogue: Catalogue;\n  commands: GameCommands;\n  changes: Changes;\n}\n\nconst roundOf = (game: GameState) => game.current_round ?? 0;\n\nfunction NextButton({ commands, label, onClick }: { commands: GameCommands; label: string; onClick: () => void }) {\n  return (\n    <Panel>\n      <button type=\"button\" className=\"btn btn--primary btn--wide\" disabled={commands.pending} onClick={onClick}>\n        {label}\n      </button>\n    </Panel>\n  );\n}\n\n/** Start of a regular round: show what each team will receive, then hand the tokens out. */\nexport function AllocationScreen({ game, catalogue, commands, changes }: ScreenProps) {\n  const round = roundOf(game);\n  return (\n    <BoardScreen\n      game={game}\n      copy={stepCopy(game)}\n      changes={changes}\n      error={commands.error}\n      side={\n        <>\n          <Panel kicker=\"Resource tokens\" title=\"Fresh units for each team\">\n            <ResourceTokens\n              caption=\"Resources each team receives\"\n              rows={catalogue.teams.map((card) => ({ role: card.role, resources: card.allowance }))}\n            />\n            <ul className=\"plain-list muted\">\n              {catalogue.teams.map((card) => (\n                <li key={card.role}>\n                  {card.name}: {allowanceText(card.allowance)}\n                </li>\n              ))}\n            </ul>\n          </Panel>\n          <NextButton\n            commands={commands}\n            label=\"Allocate resources\"\n            onClick={() => commands.runStep(round, 'allocate-resources')}\n          />\n        </>\n      }\n    />\n  );\n}\n\n/** Before the dice are rolled: which hazards already hold a predicted die and which will roll now. */\nexport function RollHazardsScreen({ game, commands, changes }: Omit<ScreenProps, 'catalogue'>) {\n  const round = roundOf(game);\n  const dice = hazardDice(game);\n  return (\n    <BoardScreen\n      game={game}\n      copy={stepCopy(game)}\n      changes={changes}\n      error={commands.error}\n      side={\n        <>\n          <Panel kicker=\"Hazard dice\" title={round === 0 ? 'Practice resolution' : 'Before the roll'}>\n            <ul className=\"dice-list\">\n              {game.hazards.map((hazard) => {\n                const stored = dice.get(hazard.id)?.current;\n                return (\n                  <li key={hazard.id} className=\"dice-list__row\">\n                    {stored ? <DiceFace value={stored.die} size={30} /> : <span className=\"dice-list__blank\" aria-hidden=\"true\" />}\n                    <span className=\"dice-list__name\">{hazard.name}</span>\n                    <span className=\"muted\">{stored ? 'predicted' : 'rolls now'}</span>\n                  </li>\n                );\n              })}\n            </ul>\n            {round === 0 && (\n              <p className=\"muted\">Only the first two triggered hazards, left to right, cause damage in Round 0.</p>\n            )}\n          </Panel>\n          <EventQueue game={game} />\n          <NextButton\n            commands={commands}\n            label=\"Roll hazard dice\"\n            onClick={() => commands.runStep(round, 'resolve-hazards')}\n          />\n        </>\n      }\n    />\n  );\n}\n\n/** After the dice: every hazard's outcome and the damage it caused. */\nexport function HazardResultsScreen({ game, commands, changes }: Omit<ScreenProps, 'catalogue'>) {\n  const round = roundOf(game);\n  return (\n    <BoardScreen\n      game={game}\n      copy={stepCopy(game)}\n      changes={changes}\n      error={commands.error}\n      side={\n        <>\n          <HazardOutcomePanel game={game} round={round} />\n          <EventQueue game={game} />\n          <NextButton commands={commands} label=\"Reveal event\" onClick={() => commands.runStep(round, 'apply-event')} />\n        </>\n      }\n    />\n  );\n}\n\nexport function HazardOutcomePanel({ game, round }: { game: GameState; round: number }) {\n  const rolls = game.hazard_rolls.filter((roll) => roll.round === round && roll.resolved);\n  const applied = rolls.filter((roll) => roll.applied).length;\n  return (\n    <Panel kicker={`Round ${round} \\u2022 after damage`} title={applied === 1 ? 'One hazard resolved' : `${applied} hazards resolved`}>\n      <HazardDiceList game={game} rolls={rolls} />\n      <StatusChangeList game={game} changes={hazardStatusChanges(game, round)} />\n    </Panel>\n  );\n}\n\n/** After the event is applied: the card, with what it changed. */\nexport function EventResultScreen({ game, commands, changes }: Omit<ScreenProps, 'catalogue'>) {\n  const round = roundOf(game);\n  const events = game.events.filter((event) => event.round === round && event.status !== 'pending');\n  return (\n    <BoardScreen\n      game={game}\n      copy={stepCopy(game)}\n      changes={changes}\n      error={commands.error}\n      side={\n        <>\n          <Panel kicker=\"Event card &bull; revealed\">\n            {events.length === 0 ? (\n              <p>No event in this round.</p>\n            ) : (\n              events.map((event) => <EventCardView key={event.id} event={event} game={game} mode=\"result\" />)\n            )}\n          </Panel>\n          <NextButton commands={commands} label=\"Calculate scores\" onClick={() => commands.runStep(round, 'score')} />\n        </>\n      }\n    />\n  );\n}\n\n/** End of Round 0: damage shown, predicted dice for Round 1 are ready. */\nexport function RoundZeroResultScreen({ game, commands, changes }: Omit<ScreenProps, 'catalogue'>) {\n  const next = [...hazardDice(game).entries()].flatMap(([hazardId, dice]) => (dice.next ? [{ hazardId, die: dice.next.die }] : []));\n  return (\n    <BoardScreen\n      game={game}\n      copy={stepCopy(game)}\n      changes={changes}\n      error={commands.error}\n      side={\n        <>\n          <HazardOutcomePanel game={game} round={0} />\n          {next.map((item) => (\n            <Panel key={item.hazardId} className=\"next-die\">\n              <p className=\"next-die__label\">Next die &bull; {hazardName(game, item.hazardId)}</p>\n              <p className=\"next-die__value\">NEXT DIE = {item.die}</p>\n              <p className=\"muted\">Stored by Hazard Prediction and used in Round 1.</p>\n            </Panel>\n          ))}\n          <NextButton commands={commands} label=\"Continue to Round 1\" onClick={() => commands.runStep(0, 'complete')} />\n        </>\n      }\n    />\n  );\n}\n\n/** After scoring: the round's scores and the choice to continue or finish. */\nexport function ScoresScreen({ game, commands, changes }: Omit<ScreenProps, 'catalogue'>) {\n  const round = roundOf(game);\n  const last = round >= game.total_rounds;\n  const [confirming, setConfirming] = useState(false);\n  return (\n    <BoardScreen\n      game={game}\n      copy={stepCopy(game)}\n      changes={changes}\n      error={commands.error}\n      side={\n        <>\n          <Panel kicker={`Round ${round} score`}>\n            <ScoreList rows={roundScores(game, round)} />\n          </Panel>\n          <Panel kicker=\"End-of-round choice\" title=\"The moderator chooses when to advance.\">\n            {!last && (\n              <button\n                type=\"button\"\n                className=\"btn btn--primary btn--wide\"\n                disabled={commands.pending}\n                onClick={() => commands.runStep(round, 'complete')}\n              >\n                CONTINUE TO ROUND {round + 1}\n              </button>\n            )}\n            {confirming ? (\n              <div className=\"confirm\" role=\"alertdialog\" aria-label=\"Confirm finishing the game\">\n                <p>\n                  Finish the game after Round {round}? The final scores will be the Round {round} scores.\n                </p>\n                <button\n                  type=\"button\"\n                  className=\"btn btn--primary\"\n                  disabled={commands.pending}\n                  onClick={() => commands.finishGame()}\n                >\n                  Yes, finish the game\n                </button>\n                <button type=\"button\" className=\"btn btn--ghost\" onClick={() => setConfirming(false)}>\n                  Cancel\n                </button>\n              </div>\n            ) : (\n              <button\n                type=\"button\"\n                className={`btn btn--wide ${last ? 'btn--primary' : 'btn--soft'}`}\n                disabled={commands.pending}\n                onClick={() => setConfirming(true)}\n              >\n                FINISH GAME\n              </button>\n            )}\n            <p className=\"muted\">Keep all statuses, vulnerability values, probabilities, markers and predicted dice.</p>\n            <p className=\"muted\">Unused resources expire when the next round starts.</p>\n          </Panel>\n        </>\n      }\n    />\n  );\n}\n\n/** The game is over: final board, final scores (the last round played) and the game history. */\nexport function FinalScreen({ game, changes }: Pick<ScreenProps, 'game' | 'changes'>) {\n  const last = latestScoredRound(game);\n  const rows = last === null ? [] : roundScores(game, last);\n  return (\n    <BoardScreen\n      game={game}\n      copy={stepCopy(game)}\n      changes={changes}\n      side={<FinalSide game={game} rows={rows} />}\n    />\n  );\n}\n\nexport function FinalSide({ game, rows }: { game: GameState; rows: ReturnType<typeof roundScores> }) {\n  return (\n    <>\n      <Panel kicker=\"Final scores\">\n        <ScoreList rows={rows} winners={game.winners} />\n      </Panel>\n      <Panel kicker=\"Game history\">\n        <HistoryList rounds={buildHistory(game)} />\n      </Panel>\n    </>\n  );\n}\n\nexport function TokensPanel({ game }: { game: GameState }) {\n  return (\n    <Panel kicker=\"Resource tokens\">\n      <ResourceTokens\n        caption=\"Current resource balances\"\n        rows={orderedTeams(game).map((team) => ({ role: team.role, resources: team.resources }))}\n      />\n    </Panel>\n  );\n}\n"],"file":"/src/features/round/StepScreens.tsx"}