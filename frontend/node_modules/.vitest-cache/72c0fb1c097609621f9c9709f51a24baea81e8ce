,KAAK,iDAAC,QAAD;IAAM,WAAU;cAAhB,CAAwB,eAAkB,yCAAe,MAAM,MAAM,CAAQ;;;;;WAC5G,KAHK,OAAO;;;;UAGZ,CACL;EACC;;;;;CAED;;;;;AAEX","names":[],"ignoreList":[],"sources":["ActionScreens.tsx"],"sourcesContent":["import { useState } from 'react';\nimport type { ActionCard, Catalogue, GameState, PaymentInput } from '../../api/types';\nimport type { GameCommands } from '../../api/queries';\nimport { ActionCardView } from '../../components/ActionCardView';\nimport { BoardScreen } from '../../components/BoardScreen';\nimport { Panel } from '../../components/GameLayout';\nimport { ResourceTokens, costSummary } from '../../components/Tokens';\nimport { stepCopy } from '../../lib/copy';\nimport {\n  actionsInRound,\n  describeAction,\n  describePayers,\n  orderedTeams,\n  reduceEmissionsInfo,\n  type Changes,\n} from '../../lib/derive';\nimport { FundingForm } from './FundingForm';\nimport { EMPTY_TARGET, TargetPicker, isTargetComplete, type Target, type TargetKind } from './TargetPicker';\n\ninterface ScreenProps {\n  game: GameState;\n  catalogue: Catalogue;\n  commands: GameCommands;\n  changes: Changes;\n}\n\nconst KIND_OF: Record<string, TargetKind | null> = {\n  hazard_prediction: 'predict',\n  risk_adaptation: 'adapt',\n  local_investment: 'invest',\n  reduce_emissions: null,\n};\n\nfunction cardFor(catalogue: Catalogue, key: string): ActionCard {\n  const card = catalogue.actions.find((item) => item.key === key);\n  if (!card) throw new Error(`The catalogue has no action card \"${key}\".`);\n  return card;\n}\n\n/** Runs the action for the chosen target. Resolves to the new state, or null when the API refused it. */\nfunction runAction(commands: GameCommands, key: string, target: Target, payments: PaymentInput[]) {\n  switch (key) {\n    case 'hazard_prediction':\n      return commands.predict({ hazard_id: target.hazardId ?? 0, payments });\n    case 'risk_adaptation':\n      return commands.adapt({ element_id: target.elementId ?? 0, hazard_id: target.hazardId ?? 0, payments });\n    case 'local_investment':\n      return commands.invest({ element_id: target.elementId ?? 0, payments });\n    default:\n      return commands.reduceEmissions(payments);\n  }\n}\n\nfunction LastAction({ game }: { game: GameState }) {\n  const last = actionsInRound(game, game.current_round ?? 0).at(-1);\n  if (!last) return null;\n  return (\n    <Panel kicker=\"Last action\">\n      <p>{describeAction(game, last)}</p>\n      {describePayers(game, last) && <p className=\"muted\">Paid by: {describePayers(game, last)}</p>}\n    </Panel>\n  );\n}\n\nconst PRACTICE_KEY: Record<string, string> = {\n  ROUND0_PREDICTION: 'hazard_prediction',\n  ROUND0_ADAPTATION: 'risk_adaptation',\n  ROUND0_INVESTMENT: 'local_investment',\n};\n\n/** Round 0: one free demonstration action per step. */\nexport function PracticeScreen({ game, catalogue, commands, changes }: ScreenProps) {\n  const key = PRACTICE_KEY[game.phase] ?? 'hazard_prediction';\n  const kind = KIND_OF[key] ?? 'predict';\n  const card = cardFor(catalogue, key);\n  const [target, setTarget] = useState<Target>(EMPTY_TARGET);\n\n  return (\n    <BoardScreen\n      game={game}\n      copy={stepCopy(game)}\n      changes={changes}\n      preview={target}\n      error={commands.error}\n      side={\n        <>\n          <Panel kicker=\"Action card\">\n            <ActionCardView\n              card={card}\n              note={\n                <>\n                  {card.description} <strong>FREE in Round 0.</strong>\n                </>\n              }\n            />\n          </Panel>\n          <Panel kicker=\"Practice action\">\n            <TargetPicker game={game} limits={catalogue.limits} kind={kind} target={target} onChange={setTarget} />\n            <button\n              type=\"button\"\n              className=\"btn btn--primary\"\n              disabled={commands.pending || !isTargetComplete(kind, target)}\n              onClick={async () => {\n                if (await runAction(commands, key, target, [])) setTarget(EMPTY_TARGET);\n              }}\n            >\n              Apply practice action\n            </button>\n          </Panel>\n          <LastAction game={game} />\n        </>\n      }\n    />\n  );\n}\n\n/** Regular rounds: choose an action card, record who pays, apply it. Repeat until teams are done. */\nexport function ActionPhaseScreen({ game, catalogue, commands, changes }: ScreenProps) {\n  const [selected, setSelected] = useState<string | null>(null);\n  const [target, setTarget] = useState<Target>(EMPTY_TARGET);\n  const round = game.current_round ?? 0;\n  const emissions = reduceEmissionsInfo(game, catalogue.limits);\n  const teams = orderedTeams(game);\n\n  const status = (card: ActionCard): { enabled: boolean; note: string } => {\n    if (!card.available) return { enabled: false, note: 'Not available in this version' };\n    if (card.key !== 'reduce_emissions') return { enabled: true, note: costSummary(card.cost) };\n    if (!emissions.eligibleRound) return { enabled: false, note: `Rounds ${catalogue.limits.reduce_emissions_rounds.join(' and ')} only` };\n    if (emissions.usedThisRound) return { enabled: false, note: 'Already funded this round' };\n    return { enabled: true, note: `Progress ${emissions.progress}/${emissions.target} \\u2022 ${costSummary(card.cost)}` };\n  };\n\n  const card = selected ? cardFor(catalogue, selected) : null;\n  const kind = selected ? KIND_OF[selected] : null;\n  const targetReady = kind === null || isTargetComplete(kind, target);\n\n  return (\n    <BoardScreen\n      game={game}\n      copy={stepCopy(game)}\n      changes={changes}\n      preview={kind ? target : undefined}\n      error={commands.error}\n      side={\n        <>\n          <Panel kicker=\"Resource tokens\" title=\"Before this action\">\n            <ResourceTokens rows={teams.map((team) => ({ role: team.role, resources: team.resources }))} caption=\"Current resource balances\" />\n          </Panel>\n\n          <Panel kicker=\"Action cards\">\n            <ul className=\"action-menu\">\n              {catalogue.actions.map((item) => {\n                const { enabled, note } = status(item);\n                return (\n                  <li key={item.key}>\n                    <button\n                      type=\"button\"\n                      className={`action-menu__item${selected === item.key ? ' is-selected' : ''}`}\n                      aria-pressed={selected === item.key}\n                      disabled={!enabled}\n                      onClick={() => {\n                        setSelected(selected === item.key ? null : item.key);\n                        setTarget(EMPTY_TARGET);\n                      }}\n                    >\n                      <strong>{item.name}</strong>\n                      <span>{note}</span>\n                    </button>\n                  </li>\n                );\n              })}\n            </ul>\n          </Panel>\n\n          {card && (\n            <Panel kicker={card.name} title=\"Record the action\">\n              <ActionCardView card={card} compact />\n              {kind && (\n                <TargetPicker game={game} limits={catalogue.limits} kind={kind} target={target} onChange={setTarget} />\n              )}\n              <FundingForm\n                key={card.key}\n                cost={card.cost}\n                teams={teams}\n                disabled={commands.pending || !targetReady}\n                submitLabel=\"Apply action\"\n                onSubmit={async (payments) => {\n                  if (await runAction(commands, card.key, target, payments)) {\n                    setSelected(null);\n                    setTarget(EMPTY_TARGET);\n                  }\n                }}\n              />\n            </Panel>\n          )}\n\n          <ActionLog game={game} round={round} />\n\n          <Panel>\n            <button\n              type=\"button\"\n              className=\"btn btn--primary btn--wide\"\n              disabled={commands.pending}\n              onClick={() => commands.runStep(round, 'close-actions')}\n            >\n              Close action phase\n            </button>\n          </Panel>\n        </>\n      }\n    />\n  );\n}\n\nfunction ActionLog({ game, round }: { game: GameState; round: number }) {\n  const actions = actionsInRound(game, round);\n  return (\n    <Panel kicker={`Round ${round} actions`}>\n      {actions.length === 0 ? (\n        <p className=\"muted\">No action recorded yet.</p>\n      ) : (\n        <ol className=\"log\">\n          {actions.map((action) => (\n            <li key={action.id}>\n              {describeAction(game, action)}\n              {describePayers(game, action) && <span className=\"muted\"> &mdash; paid by {describePayers(game, action)}</span>}\n            </li>\n          ))}\n        </ol>\n      )}\n    </Panel>\n  );\n}\n"],"file":"/src/features/round/ActionScreens.tsx"}