atalogue: Catalogue, selected: ReadonlyMap<string, number>, custom: string[]): HazardInput[] {\n  return [...catalogue.hazards, ...custom]\n    .filter((name) => selected.has(name))\n    .map((name) => ({ name, probability: selected.get(name) ?? DEFAULT_PROBABILITY }));\n}\n\nexport function HazardsStep({ catalogue, saved, busy, onBack, onSave }: HazardsStepProps) {\n  const [selected, setSelected] = useState<Map<string, number>>(\n    () => new Map(saved.map((hazard) => [hazard.name, hazard.probability])),\n  );\n  const [custom, setCustom] = useState<string[]>(() =>\n    saved.map((hazard) => hazard.name).filter((name) => !catalogue.hazards.includes(name)),\n  );\n  const [adding, setAdding] = useState(false);\n  const [draft, setDraft] = useState('');\n  const [draftError, setDraftError] = useState<string | null>(null);\n\n  const { hazards_min: min, hazards_max: max, probability_min: lowest, probability_max: highest } = catalogue.limits;\n  const count = selected.size;\n  const full = count >= max;\n  const valid = count >= min && count <= max;\n  const names = [...catalogue.hazards, ...custom];\n  const probabilities = Array.from({ length: highest - lowest + 1 }, (_, index) => lowest + index);\n\n  const toggle = (name: string) =>\n    setSelected((current) => {\n      const next = new Map(current);\n      if (next.has(name)) next.delete(name);\n      else if (next.size < max) next.set(name, DEFAULT_PROBABILITY);\n      return next;\n    });\n\n  const setProbability = (name: string, probability: number) =>\n    setSelected((current) => new Map(current).set(name, probability));\n\n  const addCustom = (event: FormEvent) => {\n    event.preventDefault();\n    const name = draft.trim();\n    if (!name) return setDraftError('Enter a name for the hazard.');\n    if (names.some((known) => known.toLowerCase() === name.toLowerCase())) {\n      return setDraftError(`\"${name}\" is already in the list.`);\n    }\n    if (full) return setDraftError(`You can select at most ${max} hazards.`);\n    setCustom((current) => [...current, name]);\n    setSelected((current) => new Map(current).set(name, DEFAULT_PROBABILITY));\n    setDraft('');\n    setDraftError(null);\n    setAdding(false);\n  };\n\n  return (\n    <>\n      <section className=\"setup-card\" aria-labelledby=\"hazard-catalogue\">\n        <header className=\"setup-card__head\">\n          <h2 id=\"hazard-catalogue\" className=\"kicker\">\n            Hazard catalogue &middot; {names.length} available\n          </h2>\n          <span className=\"legend\">\n            <span aria-hidden=\"true\">&#10003;</span> Selected <span aria-hidden=\"true\">&#9744;</span> Not selected\n          </span>\n        </header>\n\n        <div className=\"choices choices--two-columns choices--hazards\">\n          {names.map((name) => {\n            const checked = selected.has(name);\n            return (\n              <Choice\n                key={name}\n                label={name}\n                tone=\"red\"\n                checked={checked}\n                disabled={!checked && full}\n                onChange={() => toggle(name)}\n              >\n                {checked ? (\n                  <label className=\"probability-pill\">\n                    <span className=\"sr-only\">Probability for {name}</span>\n                    <select\n                      value={selected.get(name)}\n                      onChange={(event) => setProbability(name, Number(event.target.value))}\n                    >\n                      {probabilities.map((value) => (\n                        <option key={value} value={value}>\n                          Probability {value}/{highest}\n                        </option>\n                      ))}\n                    </select>\n                  </label>\n                ) : (\n                  <span className=\"choice__hint\">Not selected</span>\n                )}\n              </Choice>\n            );\n          })}\n        </div>\n\n        <footer className=\"setup-card__foot\">\n          <p className={`counter${valid ? ' counter--ok' : ''}`}>\n            {count} of {max} selected &bull;{' '}\n            {full ? 'Deselect one to activate a custom hazard' : `choose at least ${min}`}\n          </p>\n          {adding ? (\n            <form className=\"inline-add\" onSubmit={addCustom}>\n              <label>\n                <span className=\"sr-only\">Custom hazard name</span>\n                <input\n                  value={draft}\n                  maxLength={NAME_MAX}\n                  placeholder=\"Custom hazard name\"\n                  onChange={(event) => setDraft(event.target.value)}\n                />\n              </label>\n              <button type=\"submit\" className=\"btn btn--primary btn--small\">\n                Add\n              </button>\n              <button\n                type=\"button\"\n                className=\"btn btn--ghost btn--small\"\n                onClick={() => {\n                  setAdding(false);\n                  setDraft('');\n                  setDraftError(null);\n                }}\n              >\n                Cancel\n              </button>\n              {draftError && (\n                <span className=\"field-error\" role=\"alert\">\n                  {draftError}\n                </span>\n              )}\n            </form>\n          ) : (\n            <button type=\"button\" className=\"btn btn--soft\" onClick={() => setAdding(true)} disabled={full}>\n              + Add custom hazard\n            </button>\n          )}\n        </footer>\n      </section>\n      <p className=\"muted\">\n        A hazard triggers when its die roll is at or below its probability, so 3/6 means roughly every second round.\n        Teams see these as game probabilities.\n      </p>\n\n      <StepActions\n        onBack={onBack}\n        onNext={() => onSave(orderHazards(catalogue, selected, custom))}\n        nextLabel=\"Save hazards\"\n        nextDisabled={!valid}\n        busy={busy}\n        hint={valid ? undefined : `Select ${min === max ? max : `${min} or ${max}`} hazards to continue.`}\n      />\n    </>\n  );\n}\n"],"file":"/src/features/setup/HazardsStep.tsx"}